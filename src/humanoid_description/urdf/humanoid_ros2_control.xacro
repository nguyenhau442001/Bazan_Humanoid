<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="humanoid_ros2_control" params="name">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>

      <!-- Upper Body -->
      <joint name="torso_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="head_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      <joint name="head_pitch_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <!-- Left Leg (6 DOF) -->
      <xacro:macro name="leg_control" params="prefix">
        <joint name="${prefix}_hip_yaw_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}_hip_roll_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}_hip_pitch_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}_knee_pitch_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}_ankle_pitch_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}_ankle_roll_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:leg_control prefix="left"/>
      <xacro:leg_control prefix="right"/>

      <!-- Arms -->
      <xacro:macro name="arm_control" params="prefix">
        <joint name="${prefix}_shoulder_pitch_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}_shoulder_roll_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}_elbow_pitch_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
      </xacro:macro>

      <xacro:arm_control prefix="left"/>
      <xacro:arm_control prefix="right"/>

    </ros2_control>
  </xacro:macro>
</robot>
